# Copia este archivo a .env.local y llena los valores con los datos
# de tu proyecto de Supabase (Project Settings → API).
# .env.local NUNCA se sube a GitHub (ya está en .gitignore).

NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=pega-aqui-la-anon-o-publishable-key
